# --- LLM (OpenAI-совместимый API) ---
# Ключ можно взять у OpenAI, OpenRouter, DeepSeek и т.п.
# Пока ключа нет — рекомендации строит база правил, ИИ-текст просто не появится.
LLM_API_KEY=
# Базовый URL OpenAI-совместимого API (можете не менять, если ключ от OpenAI)
LLM_BASE_URL=https://api.openai.com/v1
# Модель: gpt-4o-mini / openai/gpt-4o-mini (OpenRouter) / deepseek-chat и т.п.
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20

# --- Приложение ---
SECRET_KEY=change-me-to-a-random-string
DATABASE_PATH=medai.db
