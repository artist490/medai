# --- LLM (PlusVibe API, OpenAI-совместимый: https://plusvibeapi.ru/v1) ---
# Ключ формата sk-pv-... из личного кабинета plusvibeapi.ru (оплата в рублях, данные в РФ).
# Нет ключа — рекомендации строит база правил, ИИ-текст и чат честно пишут «недоступно».
# PlusVibe — внешний обработчик: ПДн обезличены во всех каналах (анализ, сводка, чат, F034) —
# имя и ID не передаются; очевидные контакты в тексте автоматически скрываются.
LLM_API_KEY=
LLM_BASE_URL=https://plusvibeapi.ru/v1
# Модель текста рекомендаций анализа
LLM_MODEL=deepseek-v4.1-flash-1017
# Модель агентного чата (поддерживает function calling)
CHAT_MODEL=deepseek-v4.1-flash-1017
LLM_TIMEOUT=20

# --- Приложение ---
APP_ENV=development
DATABASE_PATH=medai.db
# В production обязательно HTTPS + CORS_ORIGINS=https://medai.example.ru
ENFORCE_HTTPS=false
SECURE_COOKIES=false
SESSION_TTL_DAYS=7
CORS_ORIGINS=
# Разрешить HTTP только для защищённой локальной LLM. Внешний API — только HTTPS.
LLM_ALLOW_INSECURE_HTTP=false

# Серверный OCR: веса ocria-nano лежат в репозитории (backend/models/ocria-nano),
# скачивание не требуется. Лицензия модели — backend/models/ocria-nano/LICENSE.
# Без переменной: автоматически включён, если веса найдены.
# Явное false всегда отключает OCR; true требует фактически установленной модели.
# OCR_ENABLED=true
OCR_MODEL=ocria-nano
OCR_MAX_PAGES=10
OCR_WORKERS=1
OCR_TIMEOUT=180
OCR_MAX_TEXT=200000
