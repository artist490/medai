# --- LLM (PlusVibe API, OpenAI-совместимый: https://plusvibeapi.ru/v1) ---
# Ключ формата sk-pv-... из личного кабинета plusvibeapi.ru (оплата в рублях, данные в РФ).
# Нет ключа — рекомендации строит база правил, ИИ-текст и чат честно пишут «недоступно».
LLM_API_KEY=
LLM_BASE_URL=https://plusvibeapi.ru/v1
# Модель текста рекомендаций анализа
LLM_MODEL=deepseek-v4.1-flash-1017
# Модель агентного чата (поддерживает function calling)
CHAT_MODEL=deepseek-v4.1-flash-1017
LLM_TIMEOUT=20

# --- Приложение ---
SECRET_KEY=change-me-to-a-random-string
DATABASE_PATH=medai.db
